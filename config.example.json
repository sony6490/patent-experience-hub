{
  "root": "<VAULT_ROOT>",
  "vault_name": "MyVault",
  "scan_dirs": [
    "项目资料",
    "归档文件",
    "供应商资料",
    "公司资料"
  ],
  "exclude_dirs": [
    "node_modules",
    ".obsidian",
    ".trash",
    "财务资料",
    "个人档案",
    "__pycache__",
    ".git",
    "data"
  ],
  "exclude_file_prefixes": [
    "~$"
  ],
  "text_exts": [
    ".docx",
    ".xlsx",
    ".pptx",
    ".pdf",
    ".doc",
    ".xls",
    ".txt",
    ".md",
    ".csv",
    ".html",
    ".htm"
  ],
  "pdf_whitelist_keywords": "报告|report|FTO|无效|检索|分析|意见|综述|评估|预警|查新",
  "max_file_mb": 60,
  "text_cap_chars": 800000,
  "code_pattern": "",
  "tech_fields": {
    "机器人本体": [
      "机器人",
      "机械臂",
      "AGV",
      "ROBOT"
    ],
    "动力电池": [
      "电池",
      "电芯",
      "模组",
      "PACK",
      "BATTERY"
    ],
    "半导体封装": [
      "封装",
      "晶圆",
      "WAFER",
      "PACKAGING"
    ],
    "医疗器械": [
      "导管",
      "支架",
      "超声",
      "MEDICAL"
    ],
    "外观设计": [
      "外观",
      "DESIGN"
    ]
  },
  "db": "data/kb.db",
  "text_cache": "data/text",
  "tombstones": "data/tombstones",
  "sync_interval_sec": 300,
  "tombstone_days": 30,
  "server_host": "127.0.0.1",
  "server_port": 8766
}
